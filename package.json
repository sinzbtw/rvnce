{
  "name": "rvnce",
  "version": "0.2.0",
  "private": true,
  "description": "An open-source editor and static exporter for personal bio pages",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx scripts/build-demo.ts --dev && vite",
    "build": "vite build && tsx scripts/build-demo.ts",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings src scripts tests vite.config.ts playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "fflate": "0.8.3",
    "lucide-preact": "1.79.0",
    "motion": "14.14.0",
    "preact": "11.2.0",
    "preact-render-to-string": "6.8.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^24",
    "oxlint": "1.95.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
